  m_Script: {fileID: 11500000, guid: 3569a3d4c58cc06418458b4d72bf1bc7, type: 3}
  m_Name: Ren_FirstEncounter
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  nodes:
  - speakerName: REN
    dialogueText: '"You''re late."'
    nextNodeIndex: -1
    choices:
    - responseText: Late for what?
      nextNodeIndex: 1
      familiarityChange: 1
      trustChange: 0
      comfortChange: 0
      flagToSet: AskedWhyLate
      requiredFlag: 
      forbiddenFlag: 
    - responseText: Miss me that much?
      nextNodeIndex: 4
      familiarityChange: 2
      trustChange: 0
      comfortChange: 1
      flagToSet: TeasedRen
      requiredFlag: 
      forbiddenFlag: 
    - responseText: Sorry, got held up.
      nextNodeIndex: 3
      familiarityChange: 1
      trustChange: 1
      comfortChange: 0
      flagToSet: ApologizedToRen
      requiredFlag: 
      forbiddenFlag: 
  - speakerName: REN
    dialogueText: "\u201CFirst pick. New arrivals went out at noon.\u201D"
    nextNodeIndex: 2
    choices: []
  - speakerName: REN
    dialogueText: '"People get competetive."'
    nextNodeIndex: 7
    choices: []
  - speakerName: REN
    dialogueText: '"You always introduce yourself like that?"'
    nextNodeIndex: 4
    choices: []
  - speakerName: REN
    dialogueText: '"New arrivals. You missed the rush."'
    nextNodeIndex: 7
    choices: []
  - speakerName: REN
    dialogueText: "\"For the records. You\u2019re late for the records.\""
    nextNodeIndex: 6
    choices: []
  - speakerName: REN
    dialogueText: "\"You don\u2019t have to apologize.\""
    nextNodeIndex: 7
    choices: []
  - speakerName: REN
    dialogueText: "\"Anything you\u2019re looking for? \""
    nextNodeIndex: 8
    choices: []
  - speakerName: PLAYER
    dialogueText: "\"Mostly looking around. I\u2019ve walked past a few times.\""
    nextNodeIndex: 9
    choices: []
  - speakerName: REN
    dialogueText: '"Finally gave in?"'
    nextNodeIndex: 10
    choices: []
  - speakerName: PLAYER
    dialogueText: '"Something like that."'
    nextNodeIndex: 11
    choices: []
  - speakerName: REN
    dialogueText: '"Genres are marked. Mostly."'
    nextNodeIndex: 12
    choices: []
  - speakerName: PLAYER
    dialogueText: '"Mostly?"'
    nextNodeIndex: 13
    choices: []
  - speakerName: REN
    dialogueText: '"People have opinions."'
    nextNodeIndex: 14
    choices: []
  - speakerName: REN
    dialogueText: "\"If something\u2019s in the wrong place, leave it. I\u2019ll
      deal with it.\""
    nextNodeIndex: -1
    choices: []
